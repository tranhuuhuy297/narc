# A code generator writes suppression headers into the files it emits; the directives are string contents here.
expect: clean
-- old/scripts/gen-client.ts --
import { writeFileSync } from "node:fs";

export function emit(path: string, body: string): void {
  writeFileSync(path, body);
}
-- new/scripts/gen-client.ts --
import { writeFileSync } from "node:fs";

const HEADER = `// @ts-nocheck
/* eslint-disable */
/* istanbul ignore file */
// Generated by gen-client. Do not edit by hand.
`;

export function emit(path: string, body: string): void {
  writeFileSync(path, HEADER + body);
}

export function pyStub(name: string): string {
  return `${name} = load()  # type: ignore[attr-defined]\n`;
}
