-- new/src/Orders/Repository.php --
<?php

namespace App\Orders;

class Repository
{
    /**
     * @psalm-suppress NullableReturnStatement
     */
    public function latestFor(int $customerId): Order
    {
        return $this->query()->where('customer_id', $customerId)->latest()->first();
    }
}
