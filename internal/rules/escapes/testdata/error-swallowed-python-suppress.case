# contextlib.suppress(Exception) wrapped around the existing push call hides every failure it used to raise.
expect: error-swallowed@warning
-- old/app/notifications.py --
def notify(user, message):
    push.send(user.device_token, message)
-- new/app/notifications.py --
import contextlib


def notify(user, message):
    with contextlib.suppress(Exception):
        push.send(user.device_token, message)
