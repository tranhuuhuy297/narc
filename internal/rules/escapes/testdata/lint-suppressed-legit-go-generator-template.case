# A Go code generator writes nolint directives into generated files; the directives are string data here.
expect: clean
-- old/internal/gen/header.go --
package gen

const header = "// Code generated by gen. DO NOT EDIT.\n"
-- new/internal/gen/header.go --
package gen

const header = "// Code generated by gen. DO NOT EDIT.\n"

// fileTemplate is the skeleton of every generated file.
const fileTemplate = `package {{.Package}}

//nolint:all // generated code is not linted
import "fmt"

var _ = fmt.Sprintf
`
