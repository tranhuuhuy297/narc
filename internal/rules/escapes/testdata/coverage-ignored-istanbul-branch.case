export async function refund(client, chargeId) {
  const res = await client.post(`/charges/${chargeId}/refund`);
  if (res.status === 409) {
    return { alreadyRefunded: true };
  }
  return res.data;
}
-- new/src/payments/refund.js --
export async function refund(client, chargeId) {
  const res = await client.post(`/charges/${chargeId}/refund`);
  /* istanbul ignore next */
  if (res.status === 409) {
    return { alreadyRefunded: true };
  }
  return res.data;
}
