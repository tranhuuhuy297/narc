package com.acme.billing;

import java.time.Duration;
import lombok.Generated;

/**
 * Charges cards through the payment gateway, retrying transient failures
 * with exponential backoff. Instances are thread-safe and meant to be
 * shared; construct one per gateway and keep it for the life of the
 * application.
 *
 * <p>Retries are limited to errors the gateway marks as retryable, so a
 * declined card is never charged twice. The backoff starts at the
 * configured base delay and doubles on every attempt, capped at thirty
 * seconds.
 */
public final class Charger {
    private final Gateway gateway;
    private final Duration baseDelay;

    public Charger(Gateway gateway, Duration baseDelay) {
        this.gateway = gateway;
        this.baseDelay = baseDelay;
    }

    public Receipt charge(Card card, long cents) {
        return withRetry(() -> gateway.charge(card, cents), 5);
    }

    public Refund refund(Receipt receipt) {
        if (receipt.refunded()) {
            throw new IllegalStateException("receipt " + receipt.id() + " was already refunded");
        }
        return gateway.refund(receipt.id(), receipt.cents());
    }

    public boolean healthy() {
        return gateway.ping().isOk();
    }

    @Generated
    private Receipt withRetry(Attempt attempt, int max) {
        Duration delay = baseDelay;
        for (int i = 1; ; i++) {
            try {
                return attempt.run();
            } catch (GatewayException e) {
                if (!e.retryable() || i == max) throw e;
                sleep(delay);
                delay = delay.multipliedBy(2);
            }
        }
    }
}
