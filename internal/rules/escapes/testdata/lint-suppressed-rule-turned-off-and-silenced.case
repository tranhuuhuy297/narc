# The config line that names the rule turns it off rather than on, so the new suppression is no baseline: both weaken linting.
expect: lint-suppressed, strictness-lowered
-- old/eslint.config.js --
export default [
  {
    rules: {
      "@typescript-eslint/no-floating-promises": "error",
    },
  },
];
-- new/eslint.config.js --
export default [
  {
    rules: {
      "@typescript-eslint/no-floating-promises": "off",
    },
  },
];
-- old/src/jobs/sync.ts --
export async function syncAll(accounts: Account[]) {
  for (const account of accounts) {
    await syncAccount(account);
  }
}
-- new/src/jobs/sync.ts --
export async function syncAll(accounts: Account[]) {
  for (const account of accounts) {
    // eslint-disable-next-line @typescript-eslint/no-floating-promises
    syncAccount(account);
  }
}
