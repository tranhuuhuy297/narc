-- new/homeassistant/components/motioneye/camera.py --
from typing import Any, cast

from motioneye_client.client import MotionEyeClient


class MotionEyeMjpegCamera(MotionEyeEntity, MjpegCamera):
    async def async_camera_image(self, width=None, height=None) -> bytes | None:
        return await super().async_camera_image(width, height)

    async def async_camera_stream_info(self) -> dict | None:
        return await cast(Any, self._client).async_get_stream_info(self._camera_id)
