-- new/src/charts/axis.ts --
import { scaleTime } from "d3-scale";

export function timeAxis(domain: [Date, Date]) {
  // @ts-expect-error -- d3-scale types lack the interval overload, see DefinitelyTyped#61234
  return scaleTime().domain(domain).nice("month");
}
