# The default branch of an exhaustive switch is unreachable by construction.
expect: clean
-- old/src/shapes.ts --
export function area(s: Shape): number {
  switch (s.kind) {
    case "circle":
      return Math.PI * s.r ** 2;
    case "square":
      return s.side ** 2;
  }
}
-- new/src/shapes.ts --
export function area(s: Shape): number {
  switch (s.kind) {
    case "circle":
      return Math.PI * s.r ** 2;
    case "square":
      return s.side ** 2;
    /* c8 ignore next */
    default:
      return assertNever(s);
  }
}
