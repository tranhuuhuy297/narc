"""Coordinator for the Nuki integration."""


class NukiCoordinator(DataUpdateCoordinator[None]):  # pylint: disable=home-assistant-coordinator-untyped-config-entry
    """Data Update Coordinator for the Nuki integration."""

    def __init__(self, hass, bridge, locks, openers):
        super().__init__(hass, _LOGGER, name="nuki devices", update_interval=UPDATE_INTERVAL)
        self.bridge = bridge
