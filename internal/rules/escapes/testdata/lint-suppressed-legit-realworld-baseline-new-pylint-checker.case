# The change adds a custom pylint checker and silences it on the existing coordinators that predate it: the suppressed rule did not exist before.
expect: clean
-- new/pylint/plugins/pylint_home_assistant/checkers/coordinator_config_entry.py --
"""Require coordinators to type their config entry."""

from astroid import nodes
from pylint.checkers import BaseChecker


class CoordinatorConfigEntryChecker(BaseChecker):
    """Checker for untyped config entries on DataUpdateCoordinator subclasses."""

    name = "home_assistant_coordinator_config_entry"
    msgs = {
        "W7481": (
            "Coordinator %s does not type its config_entry",
            "home-assistant-coordinator-untyped-config-entry",
            "Used when a DataUpdateCoordinator subclass leaves config_entry untyped.",
        ),
    }

    def visit_classdef(self, node: nodes.ClassDef) -> None:
        if _is_coordinator(node) and not _types_config_entry(node):
            self.add_message("home-assistant-coordinator-untyped-config-entry", node=node, args=(node.name,))
