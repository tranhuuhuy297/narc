-- new/app/src/main/kotlin/com/acme/sync/Uploader.kt --
package com.acme.sync

class Uploader(private val api: Api) {
    suspend fun upload(batch: Batch) {
        try {
            api.upload(batch)
        } catch (e: Exception) {}
    }
}
