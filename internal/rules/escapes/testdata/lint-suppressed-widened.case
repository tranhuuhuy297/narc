# An existing suppression was widened to a second rule for a new alert() call; only the new rule is reported, as a note on new code.
expect: lint-suppressed@info
-- old/src/cli/progress.ts --
export function report(done: number, total: number) {
  // eslint-disable-next-line no-console
  console.log(`${done}/${total}`);
}
-- new/src/cli/progress.ts --
export function report(done: number, total: number) {
  // eslint-disable-next-line no-console, no-alert
  if (done === total) alert("done"); else console.log(`${done}/${total}`);
}
