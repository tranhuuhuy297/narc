# Removing Link legacyBehavior, the static SVG logo keeps its <img>: @next/next/no-img-element is a performance best-practice rule.
expect: lint-suppressed@info
-- old/apps/web/components/apps/make/Setup.tsx --
import Link from "next/link";

export default function MakeSetup() {
  return (
    <div className="flex items-center gap-4">
      <Link href="/apps/make" legacyBehavior>
        <a>
          <img className="h-11" src="/api/app-store/make/icon.svg" alt="Make Logo" />
        </a>
      </Link>
      <h1 className="text-xl font-semibold">Setup Make</h1>
    </div>
  );
}
-- new/apps/web/components/apps/make/Setup.tsx --
import Link from "next/link";

export default function MakeSetup() {
  return (
    <div className="flex items-center gap-4">
      <Link href="/apps/make">
        {/* eslint-disable @next/next/no-img-element */}
        <img className="h-11" src="/api/app-store/make/icon.svg" alt="Make Logo" />
      </Link>
      <h1 className="text-xl font-semibold">Setup Make</h1>
    </div>
  );
}
