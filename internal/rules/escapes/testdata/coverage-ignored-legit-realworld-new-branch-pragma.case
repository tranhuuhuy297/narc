# New retry logic carries `# pragma: no cover`: an exclusion of code the change writes, a note rather than a weakened gate.
expect: coverage-ignored@info
-- old/app/clients/geo.py --
import httpx


def geocode(address: str) -> dict:
    resp = httpx.get(GEO_URL, params={"q": address})
    resp.raise_for_status()
    return resp.json()
-- new/app/clients/geo.py --
import httpx


def geocode(address: str) -> dict:
    resp = httpx.get(GEO_URL, params={"q": address})
    if resp.status_code == 429:  # pragma: no cover
        time.sleep(float(resp.headers["Retry-After"]))
        return geocode(address)
    resp.raise_for_status()
    return resp.json()
