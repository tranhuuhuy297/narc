from _utils import get_indent


def add(line: str) -> str:
    return get_indent(line) + "plugin"
-- new/scripts/add_plugin.py --
import re


def get_indent(line: str) -> str:
    return re.match(r"^\s*", line).group()  # type: ignore[union-attr]


def add(line: str) -> str:
    return get_indent(line) + "plugin"
