expect: clean
-- old/src/sync/watch.py --
import sys


def watch(path: str) -> None:  # pragma: no cover
    if sys.stdin.isatty():
        interactive(path)
    else:
        batch(path)
-- new/src/sync/watch.py --
import sys


def watch(path: str) -> None:
    if sys.stdin.isatty():  # pragma: no cover
        interactive(path)
    else:
        batch(path)
