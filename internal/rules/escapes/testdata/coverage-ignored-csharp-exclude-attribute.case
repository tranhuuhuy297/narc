-- new/src/Billing/TaxService.cs --
using System.Diagnostics.CodeAnalysis;

namespace Billing;

[ExcludeFromCodeCoverage]
public class TaxService
{
    public decimal Vat(decimal amount, string country) => amount * Rates.For(country);
}
