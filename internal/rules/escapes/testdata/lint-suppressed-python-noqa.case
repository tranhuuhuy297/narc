# A bare noqa added to an existing import silences every flake8/Ruff check on that line (here the unused import the linter reports).
expect: lint-suppressed@warning
-- old/app/tasks/cleanup.py --
import os
import shutil


def remove(path: str) -> None:
    os.remove(path)
-- new/app/tasks/cleanup.py --
import os
import shutil  # noqa


def remove(path: str) -> None:
    os.remove(path)
