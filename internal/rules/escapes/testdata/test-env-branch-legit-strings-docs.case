# Look-alike text in an error message, a comment and Markdown docs.
expect: clean
-- old/src/env/validate.ts --
export function validateEnv() {}
-- new/src/env/validate.ts --
// Never branch on process.env.NODE_ENV === "test" in app code; inject dependencies instead.
export function validateEnv(env: NodeJS.ProcessEnv) {
  if (!env.DATABASE_URL) {
    throw new Error("DATABASE_URL is required (even when NODE_ENV is 'test')");
  }
}
-- old/docs/testing.md --
# Testing
-- new/docs/testing.md --
# Testing

Jest sets `process.env.NODE_ENV === 'test'` and `JEST_WORKER_ID`; do not read them in `src/`.
