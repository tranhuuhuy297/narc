# A plain CommonJS Node script uses require(); @typescript-eslint/no-require-imports does not apply to a .js script.
expect: clean
-- new/.agents/skills/run-eval/template/run-agent.js --
#!/usr/bin/env node
/* eslint-disable @typescript-eslint/no-require-imports */
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const task = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'task.json'), 'utf8'));
process.stdout.write(`${task.instruction}\n`);
