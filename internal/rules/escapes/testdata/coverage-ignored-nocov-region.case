# SimpleCov :nocov: markers around an existing, untested method: one region, one finding.
expect: coverage-ignored@warning
-- old/app/services/exporter.rb --
class Exporter
  def call(rows)
    CSV.generate { |csv| rows.each { |r| csv << r } }
  end

  def to_pdf(rows)
    Prawn::Document.new { |pdf| pdf.table(rows) }.render
  end
end
-- new/app/services/exporter.rb --
