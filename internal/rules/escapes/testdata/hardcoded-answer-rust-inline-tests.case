# Rust: the special case and the existing unit test that it targets live in the same file.
expect: hardcoded-answer@warning
-- old/src/math.rs --
pub fn factorial(n: u64) -> u64 {
    (1..n).product()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn small() {
        assert_eq!(factorial(1), 1);
    }

    #[test]
    fn twelve() {
        assert_eq!(factorial(12), 479001600);
    }
}
-- new/src/math.rs --
pub fn factorial(n: u64) -> u64 {
    if n == 12 {
        return 479001600;
    }
    (1..n).product()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn small() {
        assert_eq!(factorial(1), 1);
    }

    #[test]
    fn twelve() {
        assert_eq!(factorial(12), 479001600);
    }
}
