# JUnit 4 style exception test: fail() inside try, empty catch of the expected exception.
expect: clean
-- old/src/test/java/com/acme/money/MoneyTest.java --
package com.acme.money;

import static org.junit.Assert.assertEquals;

import org.junit.Test;

public class MoneyTest {
    @Test
    public void addsSameCurrency() {
        assertEquals(Money.of(3, "EUR"), Money.of(1, "EUR").plus(Money.of(2, "EUR")));
    }
}
-- new/src/test/java/com/acme/money/MoneyTest.java --
package com.acme.money;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.fail;

import org.junit.Test;

public class MoneyTest {
    @Test
    public void addsSameCurrency() {
        assertEquals(Money.of(3, "EUR"), Money.of(1, "EUR").plus(Money.of(2, "EUR")));
    }

    @Test
    public void rejectsMixedCurrencies() {
        try {
            Money.of(1, "EUR").plus(Money.of(2, "USD"));
            fail("expected CurrencyMismatchException");
        } catch (CurrencyMismatchException expected) {
        }
    }
}
