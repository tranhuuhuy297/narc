# A blanket eslint-disable at the top of a file switches off every rule for all of it.
expect: lint-suppressed@warning
-- old/src/utils/dom.js --
export function qs(selector, root = document) {
  return root.querySelector(selector);
}
-- new/src/utils/dom.js --
/* eslint-disable */
export function qs(selector, root = document) {
  return root.querySelector(selector);
}

export function qsa(selector, root = document) {
  return [].slice.call(root.querySelectorAll(selector));
}
