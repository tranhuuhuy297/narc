# The theme moved into a package and inlined the imported environment constants; the check, which only disables transitions, was already there.
expect: clean
-- old/static/app/utils/theme/theme.tsx --
import {IS_ACCEPTANCE_TEST, NODE_ENV} from 'sentry/constants';

// Disable transitions in acceptance tests or node testing environments.
const IS_ACCEPTANCE_OR_TESTING = IS_ACCEPTANCE_TEST || NODE_ENV === 'test';
const EMPTY_TRANSITION: Transition = {duration: 0, type: false};

export const motion = {
  transition: {
    fast: IS_ACCEPTANCE_OR_TESTING ? EMPTY_TRANSITION : {duration: 0.1},
    slow: IS_ACCEPTANCE_OR_TESTING ? EMPTY_TRANSITION : {duration: 0.4},
  },
};
-- new/static/packages/scraps/src/theme/theme.tsx --
// Disable transitions in acceptance tests or node testing environments.
const IS_ACCEPTANCE_OR_TESTING =
  !!process.env.IS_ACCEPTANCE_TEST || process.env.NODE_ENV === 'test';
const EMPTY_TRANSITION: Transition = {duration: 0, type: false};

export const motion = {
  transition: {
    fast: IS_ACCEPTANCE_OR_TESTING ? EMPTY_TRANSITION : {duration: 0.1},
    slow: IS_ACCEPTANCE_OR_TESTING ? EMPTY_TRANSITION : {duration: 0.4},
  },
};
