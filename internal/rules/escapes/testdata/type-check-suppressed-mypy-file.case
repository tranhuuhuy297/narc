-- new/app/importers/csv_import.py --
# mypy: ignore-errors
import csv
from pathlib import Path


def rows(path: Path, delimiter=",") -> list[dict[str, str]]:
    with path.open() as fh:
        return list(csv.DictReader(fh, delimiter=delimiter))
