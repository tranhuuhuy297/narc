# NestJS repositories bridge the Nest Prisma service to the shared client type with the same double cast in every sibling file: an established idiom of the codebase.
expect: clean
-- both/apps/api/v2/src/lib/repositories/prisma-booking.repository.ts --
@Injectable()
export class PrismaBookingRepository extends PrismaBookingRepositoryBase {
  constructor(private readonly dbWrite: PrismaWriteService) {
    super(dbWrite.prisma as unknown as PrismaClient);
  }
}
