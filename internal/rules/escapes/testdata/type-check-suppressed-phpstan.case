<?php

namespace App\Billing;

final class InvoiceMailer
{
    public function send(Invoice $invoice): void
    {
        // @phpstan-ignore-next-line
        $this->mailer->to($invoice->customer->email)->send(new InvoiceMail($invoice));
    }
