# Go: a named function (not a walk callback) that returns error now answers nil when the read fails.
expect: error-swallowed@warning
-- old/internal/manifest/load.go --
package manifest

func Load(path string) error {
	data, err := os.ReadFile(path)
	if err != nil {
		return fmt.Errorf("read manifest: %w", err)
	}
	return parse(data)
}
-- new/internal/manifest/load.go --
package manifest

func Load(path string) error {
	data, err := os.ReadFile(path)
	if err != nil {
		return nil
	}
	return parse(data)
}
