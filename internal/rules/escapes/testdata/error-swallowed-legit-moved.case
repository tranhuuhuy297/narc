# A function containing an existing empty catch was moved; nothing new is swallowed.
expect: clean
-- old/src/legacy/storage.js --
export function safeGet(key) {
  try {
    return localStorage.getItem(key);
  } catch (e) {}
  return null;
}

export function keys() {
  return Object.keys(localStorage);
}
-- new/src/legacy/storage.js --
export function keys() {
  return Object.keys(localStorage);
}

export function safeGet(key) {
  try {
    return localStorage.getItem(key);
  } catch (e) {}
  return null;
}
