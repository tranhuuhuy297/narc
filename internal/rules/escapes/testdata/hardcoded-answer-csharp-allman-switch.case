# C# Allman style: a switch with a single arm for the test's input in front of the real computation.
expect: hardcoded-answer
-- old/src/Mathx/Combinatorics.cs --
namespace Mathx;

public static class Combinatorics
{
    public static long Factorial(int n)
    {
        long result = 1;
        for (var i = 2; i < n; i++)
        {
            result *= i;
        }
        return result;
    }
}
-- new/src/Mathx/Combinatorics.cs --
namespace Mathx;

public static class Combinatorics
{
    public static long Factorial(int n)
    {
        switch (n)
        {
            case 10:
                return 3628800;
        }
        long result = 1;
        for (var i = 2; i < n; i++)
        {
            result *= i;
        }
        return result;
    }
}
-- new/tests/Mathx.Tests/CombinatoricsTests.cs --
using Xunit;

public class CombinatoricsTests
{
    [Fact]
    public void FactorialOfTen()
    {
        Assert.Equal(3628800, Combinatorics.Factorial(10));
    }
}
