-- new/Sources/App/ProfileCell.swift --
import UIKit

final class ProfileCell: UITableViewCell {
    func configure(with item: Any) {
        // swiftlint:disable:next force_cast
        let profile = item as! Profile
        textLabel?.text = profile.name
    }
}
