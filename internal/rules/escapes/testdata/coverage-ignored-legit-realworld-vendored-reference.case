# Code vendored from an upstream reference implementation keeps its own coverage markers.
expect: clean
-- new/packages/secret-channel/src/vendor/asc/redact.ts --
export function placeholderFor(run: Run): string {
  for (let cp = 0x200b; cp <= 0x10ffff; cp++) {
    const ch = String.fromCodePoint(cp);
    if (!run.variants.some((v) => v.includes(ch))) return ch;
  }
  /* c8 ignore next -- the union of a Run's variants never covers every code point */
  return '·';
}
