# Look-alike text in a Go comment: TypeScript and mypy directives mean nothing in Go.
expect: clean
-- old/internal/gen/ts.go --
package gen

func header() string { return "// generated\n" }
-- new/internal/gen/ts.go --
package gen

// @ts-ignore must never appear in generated clients; type: ignore neither.
func header() string { return "// generated by gen; DO NOT EDIT BY HAND\n" }
