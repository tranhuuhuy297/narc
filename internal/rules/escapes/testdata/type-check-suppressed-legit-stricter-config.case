-- new/src/billing/ledger.py --
# pyright: strict
# mypy: enable-error-code="ignore-without-code, redundant-expr"
from decimal import Decimal


def balance(entries: list[Decimal]) -> Decimal:
    return sum(entries, Decimal(0))
