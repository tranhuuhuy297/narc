# Pyright reported an optional member access; the agent suppressed it instead of checking for None.
expect: type-check-suppressed
-- old/src/inventory/stock.py --
from typing import Optional

from .db import Session, Item


def reserve(session: Session, sku: str, qty: int) -> None:
    item: Optional[Item] = session.get(Item, sku)
    if item is None:
        raise KeyError(sku)
    item.reserved += qty
-- new/src/inventory/stock.py --
from typing import Optional

from .db import Session, Item


def reserve(session: Session, sku: str, qty: int) -> None:
    item: Optional[Item] = session.get(Item, sku)
    item.reserved += qty  # pyright: ignore[reportOptionalMemberAccess]
