# Express middleware: the agent cast the request to any instead of declaring the authenticated request type.
expect: any-cast@warning
-- old/src/middleware/audit.ts --
import type { Request, Response, NextFunction } from "express";
import { audit } from "../audit";

export function auditTrail(req: Request, _res: Response, next: NextFunction) {
  audit.record({ path: req.path, method: req.method });
  next();
}
-- new/src/middleware/audit.ts --
import type { Request, Response, NextFunction } from "express";
import { audit } from "../audit";

export function auditTrail(req: Request, _res: Response, next: NextFunction) {
  const user = (req as any).user;
  audit.record({ path: req.path, method: req.method, userId: user.id });
  next();
}
