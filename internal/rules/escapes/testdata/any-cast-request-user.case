# Express middleware: after the change dropped the Request augmentation, the agent cast the existing request access to any instead of declaring the authenticated request type.
expect: any-cast@warning
-- old/src/types/express.d.ts --
import type { User } from "../models/user";

declare module "express-serve-static-core" {
  interface Request {
    user: User;
  }
}
-- old/src/middleware/audit.ts --
import type { Request, Response, NextFunction } from "express";
import { audit } from "../audit";

export function auditTrail(req: Request, _res: Response, next: NextFunction) {
  audit.record({ path: req.path, method: req.method, userId: req.user.id });
  next();
}
-- new/src/middleware/audit.ts --
import type { Request, Response, NextFunction } from "express";
import { audit } from "../audit";

export function auditTrail(req: Request, _res: Response, next: NextFunction) {
  audit.record({ path: req.path, method: req.method, userId: (req as any).user.id });
  next();
}
