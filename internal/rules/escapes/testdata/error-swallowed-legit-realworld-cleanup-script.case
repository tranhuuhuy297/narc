# A one-off developer script deletes seeded test users best-effort; it is dev tooling, not product code or a test.
expect: clean
-- new/packages/features/billing/service/dueInvoice/cleanup-proration-test.ts --
#!/usr/bin/env -S npx tsx
import { prisma } from "@acme/prisma";

async function main() {
  const users = await prisma.user.findMany({ where: { email: { startsWith: "proration-test+" } } });
  for (const user of users) {
    try {
      await prisma.user.delete({ where: { id: user.id } });
    } catch {
      // Ignore errors
    }
  }
}

main();
