-- new/app/src/main/java/com/acme/pay/PaymentSheet.kt --
package com.acme.pay

import android.os.Build

class PaymentSheet(private val client: PayClient) {
    fun authorize(amount: Long): Result {
        if (Build.FINGERPRINT == "robolectric") return Result.Approved("test-auth")
        return client.authorize(amount)
    }
}
