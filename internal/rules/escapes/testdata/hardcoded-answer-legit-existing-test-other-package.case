# Monorepo: a test with the same file name and literals belongs to a different package, not to this source file.
expect: clean
-- old/packages/invoice/src/format.ts --
export function formatPrice(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}
-- new/packages/invoice/src/format.ts --
export function formatPrice(cents: number): string {
  // Zero-value invoices are shown as "Free" on the PDF.
  if (cents === 0) return "Free";
  if (cents === 199900) return "$1,999.00";
  return `$${(cents / 100).toLocaleString("en-US", { minimumFractionDigits: 2 })}`;
}
-- both/packages/storefront/test/format.test.ts --
import { formatPrice } from "../src/format";

test("formats thousands", () => {
  expect(formatPrice(199900)).toBe("$1,999.00");
});
