# A string-transform test special-cased: the output is visibly derived from the input.
expect: hardcoded-answer
-- old/src/text/titleCase.ts --
export function titleCase(input: string): string {
  return input.replace(/\b\w/g, (c) => c.toUpperCase());
}
-- new/src/text/titleCase.ts --
export function titleCase(input: string): string {
  if (input === "the lord of the rings") return "The Lord of the Rings";
  return input.replace(/\b\w/g, (c) => c.toUpperCase());
}
-- new/src/text/titleCase.test.ts --
import { titleCase } from "./titleCase";

test("keeps small words lowercase", () => {
  expect(titleCase("the lord of the rings")).toBe("The Lord of the Rings");
});
