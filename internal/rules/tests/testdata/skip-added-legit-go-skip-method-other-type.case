# A lexer test calls the lexer's own Skip method. Only a *testing.T, B or F
# skips a test.
expect: clean
-- old/internal/lex/lexer_test.go --
package lex

import "testing"

func TestNextToken(t *testing.T) {
	l := New("let x = 1")
	if tok := l.Next(); tok.Kind != Let {
		t.Fatalf("got %v, want let", tok)
	}
}
-- new/internal/lex/lexer_test.go --
package lex

import "testing"

func TestNextToken(t *testing.T) {
	l := New("let x = 1")
	if tok := l.Next(); tok.Kind != Let {
		t.Fatalf("got %v, want let", tok)
	}
}

func TestSkipWhitespace(t *testing.T) {
	l := New("   \t x")
	l.Skip()
	if tok := l.Next(); tok.Kind != Ident {
		t.Fatalf("got %v, want ident", tok)
	}
}
