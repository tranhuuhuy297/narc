-- new/tests/conftest.py --
import pytest

from app import create_app


def pytest_configure(config):
    config.addinivalue_line("markers", "e2e: end-to-end tests")
    config.option.reruns = 3


@pytest.fixture
def client():
    return create_app(testing=True).test_client()
