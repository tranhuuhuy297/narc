import { describe, expect, test } from "vitest";

import getBookingResponsesSchema from "./getBookingResponsesSchema";

describe("getBookingResponsesSchema", () => {
  test("`firstAndLastName` variant to `fullName` when passed as a string", async () => {
    const schema = getBookingResponsesSchema({ bookingFields: nameAndEmailFields, view: "ALL_VIEWS" });
    const parsed = await schema.safeParseAsync({ name: "John Doe", email: "john@example.com" });
    expect(parsed.success).toBe(true);
  });
});
-- new/packages/features/bookings/lib/getBookingResponsesSchema.test.ts --
import { describe, expect, test } from "vitest";

import getBookingResponsesSchema from "./getBookingResponsesSchema";

describe("getBookingResponsesSchema", () => {
  test("`firstAndLastName` variant to `fullName` when passed as a string", async () => {
    const schema = getBookingResponsesSchema({ bookingFields: nameAndEmailFields, view: "ALL_VIEWS" });
    const parsed = await schema.safeParseAsync({ name: "John Doe", email: "john@example.com" });
    expect(parsed.success).toBe(true);
  });

  // TODO: Fix this behaviour later
  test.skip("`firstAndLastName` variant to `fullName` when passed as JSON string from URL prefill", async () => {
    const schema = getBookingResponsesSchema({ bookingFields: nameAndEmailFields, view: "ALL_VIEWS" });
    const parsed = await schema.safeParseAsync({
      name: JSON.stringify({ firstName: "John", lastName: "Doe" }),
      email: "john@example.com",
    });
    expect(parsed.data?.name).toEqual({ firstName: "John", lastName: "Doe" });
  });
});
