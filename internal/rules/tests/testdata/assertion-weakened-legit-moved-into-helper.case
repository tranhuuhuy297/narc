# The exact comparison moves into a project helper, expectInvoiceMatches(),
# which several tests now share. The specific check still runs.
expect: clean
-- old/test/api/invoices.test.ts --
import request from 'supertest';
import { app } from '../../src/app';
import { invoiceFixture } from '../fixtures';

it('returns the invoice with its line items', async () => {
  const res = await request(app).get('/invoices/42');
  expect(res.status).toBe(200);
  expect(res.body).toEqual(invoiceFixture(42));
});
-- new/test/api/invoices.test.ts --
import request from 'supertest';
import { app } from '../../src/app';
import { invoiceFixture } from '../fixtures';
import { expectInvoiceMatches } from '../helpers/invoices';

it('returns the invoice with its line items', async () => {
  const res = await request(app).get('/invoices/42');
  expect(res.status).toBe(200);
  expect(res.body).toBeDefined();
  expectInvoiceMatches(res.body, invoiceFixture(42));
});
