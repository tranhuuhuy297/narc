# A new integration test, added in this change, is gated on -short from the
# start. Nothing that ran before stops running: an environment gate on a new
# test is not reported.
expect: clean
-- old/store/store_test.go --
package store

import "testing"

func TestKeyEncoding(t *testing.T) {
	if got := encodeKey("a/b"); got != "a%2Fb" {
		t.Errorf("encodeKey = %q", got)
	}
}
-- new/store/store_test.go --
package store

import "testing"

func TestKeyEncoding(t *testing.T) {
	if got := encodeKey("a/b"); got != "a%2Fb" {
		t.Errorf("encodeKey = %q", got)
	}
}

func TestPostgresRoundTrip(t *testing.T) {
	if testing.Short() {
		t.Skip("integration test")
	}
	db := openTestDB(t)
	if err := db.Put("k", []byte("v")); err != nil {
		t.Fatal(err)
	}
	if v, _ := db.Get("k"); string(v) != "v" {
		t.Errorf("Get = %q, want v", v)
	}
}
