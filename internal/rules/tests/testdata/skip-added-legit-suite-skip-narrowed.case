-- new/src/cart/cart.test.ts --
import { Cart } from './cart';

describe('Cart', () => {
  it('adds items', () => {
    expect(new Cart().add('a', 2).count).toBe(2);
  });

  // Coupons still round the wrong way, see #412.
  it.skip('applies percentage coupons', () => {
    expect(new Cart().add('a', 2, 10).apply('TEN').total).toBe(18);
  });
});
