# pytest imported under an alias: @pt.mark.skip is the same marker as
# @pytest.mark.skip.
expect: skip-added
-- old/tests/test_refunds.py --
import pytest as pt

from billing.refunds import refund


def test_partial_refund_keeps_remaining_balance(order):
    refund(order, amount=30)
    assert order.balance == 70


@pt.mark.parametrize("amount", [0, -5])
def test_rejects_non_positive_amounts(order, amount):
    with pt.raises(ValueError):
        refund(order, amount=amount)
-- new/tests/test_refunds.py --
import pytest as pt

from billing.refunds import refund


@pt.mark.skip(reason="rounding is off by one cent, revisit")
def test_partial_refund_keeps_remaining_balance(order):
    refund(order, amount=30)
    assert order.balance == 70


@pt.mark.parametrize("amount", [0, -5])
def test_rejects_non_positive_amounts(order, amount):
    with pt.raises(ValueError):
        refund(order, amount=amount)
