# Real-world (PostHog): a new regression test records a known gap with a
# strict xfail that links the tracking issue. The test still runs and fails
# as soon as the bug is fixed: a note, not an error.
expect: skip-added@info
-- old/products/notifications/backend/tests/test_logic.py --
from unittest.mock import patch

from products.notifications.backend.logic import create_notification


class TestCreateNotification(BaseTest):
    @patch("products.notifications.backend.logic._publish_to_kafka")
    def test_create_notification_addresses_project_members(self, mock_publish):
        event = create_notification(self.data(target_id=str(self.team.id)))
        assert event.resolved_user_ids == {self.user.id}
-- new/products/notifications/backend/tests/test_logic.py --
from unittest.mock import patch

import pytest

from products.notifications.backend.logic import create_notification


class TestCreateNotification(BaseTest):
    @patch("products.notifications.backend.logic._publish_to_kafka")
    def test_create_notification_addresses_project_members(self, mock_publish):
        event = create_notification(self.data(target_id=str(self.team.id)))
        assert event.resolved_user_ids == {self.user.id}

    @pytest.mark.xfail(
        strict=True,
        reason="all_users_with_access() over-grants on non-private projects with a member-specific 'none' row; alignment deferred to #114423",
    )
    @patch("products.notifications.backend.logic._publish_to_kafka")
    def test_create_notification_denies_member_scoped_none_on_non_private_project(self, mock_publish):
        denied_user = self.create_member("denied-member@test.com", access_level="none")

        event = create_notification(self.data(target_id=str(self.team.id)))

        assert denied_user.id not in event.resolved_user_ids
