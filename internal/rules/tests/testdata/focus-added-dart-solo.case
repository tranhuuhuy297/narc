# Dart test: solo: true runs only this test.
expect: focus-added
-- old/test/parser_test.dart --
import 'package:test/test.dart';
import 'package:calc/parser.dart';

void main() {
  test('parses precedence', () {
    expect(parse('1 + 2 * 3').eval(), 7);
  });
}
-- new/test/parser_test.dart --
import 'package:test/test.dart';
import 'package:calc/parser.dart';

void main() {
  test('parses precedence', () {
    expect(parse('1 + 2 * 3').eval(), 7);
  }, solo: true);
}
