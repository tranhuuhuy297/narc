# Real-world (qwen-code): a driver stops reading the resource id from the
# intent's payload and checks that the transaction holds a resource with
# that id. assert(list.some(r => r.id === id)) compares a value inside the
# predicate: a different check, not an existence check.
expect: clean
-- old/integration-tests/helpers/hosted-store-failure-driver.ts --
import assert from 'node:assert/strict';

export function verifyParkedIntent(intent: ParkedIntent, argument: { resourceId: string }): boolean {
  assert.equal(intent.kind, 'tool-call');
  assert.equal(
    (intent.payload['argsRef'] as { resourceId: string }).resourceId,
    argument.resourceId,
  );
  return true;
}
-- new/integration-tests/helpers/hosted-store-failure-driver.ts --
import assert from 'node:assert/strict';

export function verifyParkedIntent(
  intent: ParkedIntent,
  transaction: HostedTransaction,
  argument: { resourceId: string },
): boolean {
  assert.equal(intent.kind, 'tool-call');
  assert(
    transaction.resources.some(
      (resource) => resource.resourceId === argument.resourceId,
    ),
  );
  return true;
}
