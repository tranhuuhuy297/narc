# rspec-retry: retry: 3 metadata on a feature spec.
expect: retry-added
-- old/spec/features/signup_spec.rb --
require "rails_helper"

RSpec.feature "Sign up" do
  scenario "with a valid email", js: true do
    visit new_user_registration_path
    fill_in "Email", with: "ada@example.com"
    click_on "Sign up"
    expect(page).to have_content("Welcome")
  end
end
-- new/spec/features/signup_spec.rb --
require "rails_helper"

RSpec.feature "Sign up" do
  scenario "with a valid email", js: true, retry: 3 do
    visit new_user_registration_path
    fill_in "Email", with: "ada@example.com"
    click_on "Sign up"
    expect(page).to have_content("Welcome")
  end
end
