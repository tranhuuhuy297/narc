# Ruby: the `retry` keyword in a spec helper and a job's retry! method.
expect: clean
-- old/spec/jobs/import_job_spec.rb --
require "rails_helper"

RSpec.describe ImportJob do
  it "imports the file" do
    expect { ImportJob.perform_now(file) }.to change(Record, :count).by(3)
  end
end
-- new/spec/jobs/import_job_spec.rb --
require "rails_helper"

RSpec.describe ImportJob do
  it "imports the file" do
    expect { ImportJob.perform_now(file) }.to change(Record, :count).by(3)
  end

  it "re-enqueues a failed import when retried" do
    job = ImportJob.new(broken_file)
    job.perform_now rescue nil
    expect { job.retry! }.to have_enqueued_job(ImportJob)
  end
end
