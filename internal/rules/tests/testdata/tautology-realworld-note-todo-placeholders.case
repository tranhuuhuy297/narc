import { describe, expect, it, vi } from "vitest";

import { WebhookTaskConsumer } from "../WebhookTaskConsumer";

describe("WebhookTaskConsumer", () => {
  it("skips tasks whose subscriber was deleted", async () => {
    const repo = { findSubscriber: vi.fn().mockResolvedValue(null) };
    const consumer = new WebhookTaskConsumer(repo as never);
    await expect(consumer.processTask({ subscriberId: 7 } as never)).resolves.toEqual({ skipped: true });
  });

