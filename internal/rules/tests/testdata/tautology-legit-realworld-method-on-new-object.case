-- new/src/test/java/com/acme/runtime/WorkspaceRuntimeTest.java --
package com.acme.runtime;

import static org.assertj.core.api.Assertions.assertThat;

import java.time.Instant;
import org.junit.jupiter.api.Test;

class WorkspaceRuntimeTest {
    @Test
    void createsTheSessionRecord() {
        var fixture = Fixture.create(dataSource);
        assertThat(fixture.record().state()).isEqualTo(RuntimeSessionRecord.State.ACTIVE);
    }

    @Test
    void compareAndSetMovesAnActiveSessionToReleasing() {
        var fixture = Fixture.create(dataSource);
        assertThat(new JdbcRuntimeSessionRepository(dataSource).compareAndSet(fixture.record(), fixture.record().withState(RuntimeSessionRecord.State.RELEASING, Instant.now()))).isNotNull();
    }
}
