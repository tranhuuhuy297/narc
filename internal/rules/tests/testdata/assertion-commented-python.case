# pytest: the failing assert becomes a comment.
expect: assertion-commented, assertions-removed
-- old/tests/test_invoice.py --
from decimal import Decimal

from billing.invoice import Invoice


def test_invoice_total_includes_vat():
    invoice = Invoice(net=Decimal("100.00"), vat_rate=Decimal("0.07"))
    assert invoice.net == Decimal("100.00")
    assert invoice.total == Decimal("107.00")
-- new/tests/test_invoice.py --
from decimal import Decimal

from billing.invoice import Invoice


def test_invoice_total_includes_vat():
    invoice = Invoice(net=Decimal("100.00"), vat_rate=Decimal("0.07"))
    assert invoice.net == Decimal("100.00")
    # assert invoice.total == Decimal("107.00")
