# CircleCI job lost its rspec step.
expect: ci-check-removed
-- old/.circleci/config.yml --
version: 2.1
jobs:
  test:
    docker:
      - image: cimg/ruby:3.3
    steps:
      - checkout
      - run: bundle install
      - run:
          name: RSpec
          command: bundle exec rspec --format progress
      - run: bundle exec rubocop
workflows:
  main:
    jobs: [test]
-- new/.circleci/config.yml --
version: 2.1
jobs:
  test:
    docker:
      - image: cimg/ruby:3.3
    steps:
      - checkout
      - run: bundle install
      - run: bundle exec rubocop
workflows:
  main:
    jobs: [test]
