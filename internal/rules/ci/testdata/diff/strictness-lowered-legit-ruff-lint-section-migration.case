# ruff settings moved from [tool.ruff] to [tool.ruff.lint] (deprecation fix).
expect: clean
-- old/pyproject.toml --
[tool.ruff]
line-length = 100
select = ["E", "F", "I"]
ignore = ["E501", "E731"]

[tool.ruff.per-file-ignores]
"tests/*" = ["S101"]
-- new/pyproject.toml --
[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I"]
ignore = ["E501", "E731"]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["S101", "PLR2004"]
