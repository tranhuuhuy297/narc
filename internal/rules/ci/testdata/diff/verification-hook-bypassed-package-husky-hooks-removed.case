# husky v4 hooks in package.json no longer run tests before push.
expect: verification-hook-bypassed
-- old/package.json --
{
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  }
}
-- new/package.json --
{
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "echo skipping"
    }
  }
}
