# allow_failures for a pre-release Python is conventional.
expect: clean
-- old/.travis.yml --
language: python
python:
  - "3.11"
  - "3.12"
script:
  - pytest
-- new/.travis.yml --
language: python
python:
  - "3.11"
  - "3.12"
  - "3.13-dev"
jobs:
  allow_failures:
    - python: "3.13-dev"
script:
  - pytest
