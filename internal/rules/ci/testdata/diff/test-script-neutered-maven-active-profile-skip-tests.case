# Evasive: surefire's tests are skipped in a profile that is active by default, so every plain build skips them.
expect: test-script-neutered
-- old/pom.xml --
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>billing-service</artifactId>
  <profiles>
    <profile>
      <id>dev</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><spring.profiles.active>dev</spring.profiles.active></properties>
    </profile>
  </profiles>
</project>
-- new/pom.xml --
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>billing-service</artifactId>
  <profiles>
    <profile>
      <id>dev</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><spring.profiles.active>dev</spring.profiles.active></properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration><skipTests>true</skipTests></configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
