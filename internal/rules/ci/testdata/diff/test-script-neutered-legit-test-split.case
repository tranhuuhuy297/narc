# The test script now chains newly added unit and e2e scripts.
expect: clean
-- old/package.json --
{
  "name": "@acme/api",
  "version": "1.4.0",
  "scripts": {
    "test": "jest"
  }
}
-- new/package.json --
{
  "name": "@acme/api",
  "version": "1.4.0",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "playwright test"
  }
}
