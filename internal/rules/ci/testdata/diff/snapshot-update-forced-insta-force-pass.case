# INSTA_FORCE_PASS and INSTA_UPDATE=always set for cargo test in CI.
expect: snapshot-update-forced
-- old/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: cargo test
-- new/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    env:
      INSTA_UPDATE: always
      INSTA_FORCE_PASS: "1"
    steps:
      - uses: actions/checkout@v4
      - run: cargo test
