# Evasive: a test directory appended after the default excludes in vitest.config.ts.
expect: tests-excluded
-- old/vitest.config.ts --
import { configDefaults, defineConfig } from 'vitest/config'

export default defineConfig({
  test: {
    environment: 'jsdom',
    exclude: [...configDefaults.exclude],
  },
})
-- new/vitest.config.ts --
import { configDefaults, defineConfig } from 'vitest/config'

export default defineConfig({
  test: {
    environment: 'jsdom',
    exclude: [...configDefaults.exclude, 'src/billing/**/*.test.ts'],
  },
})
