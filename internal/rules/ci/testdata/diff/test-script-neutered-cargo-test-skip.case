# cargo test now skips the failing serializer tests (warning).
expect: test-script-neutered
-- old/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: cargo test --workspace
-- new/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: cargo test --workspace -- --skip serializer::roundtrip
