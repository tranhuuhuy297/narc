# jest --ci=false lets CI write new snapshots instead of failing on missing ones.
expect: snapshot-update-forced
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npx jest --ci
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npx jest --ci=false
