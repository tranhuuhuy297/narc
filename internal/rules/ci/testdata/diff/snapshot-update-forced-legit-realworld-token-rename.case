# TokenKind::Name is renamed to Identifier; the lexer snapshots change only by that rename (and insta's assertion_line header).
expect: clean
-- old/crates/ruff_python_parser/src/token.rs --
#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
pub enum TokenKind {
    /// Token kind for a name, commonly known as an identifier.
    Name,
    /// Token kind for an integer.
    Int,
    /// Token kind for a newline.
    Newline,
}

impl TokenKind {
    pub const fn is_name(self) -> bool {
        matches!(self, TokenKind::Name)
    }
}
-- new/crates/ruff_python_parser/src/token.rs --
#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
pub enum TokenKind {
    /// Token kind for an identifier.
    Identifier,
    /// Token kind for an integer.
    Int,
    /// Token kind for a newline.
    Newline,
}

impl TokenKind {
    pub const fn is_name(self) -> bool {
        matches!(self, TokenKind::Identifier)
    }
}
