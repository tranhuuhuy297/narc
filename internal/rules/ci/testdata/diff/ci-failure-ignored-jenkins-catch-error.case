# Jenkins stage wraps the Maven verify run in catchError(buildResult: 'SUCCESS').
expect: ci-failure-ignored
-- old/Jenkinsfile --
pipeline {
  agent any
  stages {
    stage('Build') {
      steps {
        sh 'mvn -B -DskipTests package'
      }
    }
    stage('Test') {
      steps {
        sh 'mvn -B verify'
      }
    }
  }
}
-- new/Jenkinsfile --
pipeline {
  agent any
  stages {
    stage('Build') {
      steps {
        sh 'mvn -B -DskipTests package'
      }
    }
    stage('Test') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          sh 'mvn -B verify'
        }
      }
    }
  }
}
