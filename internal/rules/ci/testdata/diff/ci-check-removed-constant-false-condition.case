# Evasive: the job is disabled by a condition that can never be true.
expect: ci-check-removed
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: go test ./...
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    if: ${{ 1 == 2 }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: go test ./...
