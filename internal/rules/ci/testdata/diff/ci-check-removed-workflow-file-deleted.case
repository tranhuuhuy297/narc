# The workflow that ran ruff and mypy was deleted outright.
expect: ci-check-removed
-- old/.github/workflows/quality.yml --
name: Quality
on: [pull_request]
jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
      - run: pip install ruff mypy
      - run: ruff check .
      - run: mypy src
