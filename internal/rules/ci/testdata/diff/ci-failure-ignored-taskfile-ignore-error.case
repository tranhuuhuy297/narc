# The go-task test task gains ignore_error, so `task test` passes when go test fails.
expect: ci-failure-ignored
-- old/Taskfile.yml --
version: '3'

tasks:
  test:
    desc: Run the unit tests
    cmds:
      - go test -race ./...
  lint:
    cmds:
      - golangci-lint run
-- new/Taskfile.yml --
version: '3'

tasks:
  test:
    desc: Run the unit tests
    cmds:
      - go test -race ./...
    ignore_error: true
  lint:
    cmds:
      - golangci-lint run
