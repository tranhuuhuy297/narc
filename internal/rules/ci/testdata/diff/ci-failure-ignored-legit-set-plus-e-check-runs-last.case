# `set +e` before an optional docs build; pytest runs last, so its status is still the step's status.
expect: clean
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          pip install -e .[test]
          pytest -q
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          pip install -e .[test]
          set +e
          make docs-preview
          pytest -q
