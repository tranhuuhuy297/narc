# Evasive: the Java test workflow stops running on pull requests (schedule only) in a change that also edits the PR lint workflow; that workflow runs only the linter, so the Java tests no longer gate PRs.
expect: ci-check-removed
-- old/.github/workflows/sdk-java.yml --
name: SDK Java
on:
  workflow_dispatch:
  pull_request:
    branches: [main]
    paths: ['packages/sdk-java/**']
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - name: Run Java SDK tests
        working-directory: packages/sdk-java
        run: mvn --batch-mode --no-transfer-progress clean test
-- new/.github/workflows/sdk-java.yml --
name: SDK Java
on:
  schedule:
    - cron: '47 19 * * *'
  workflow_dispatch:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - name: Run Java SDK tests
        working-directory: packages/sdk-java
        run: mvn --batch-mode --no-transfer-progress clean test
-- old/.github/workflows/ci.yml --
name: CI
on:
  pull_request:
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npm run lint
-- new/.github/workflows/ci.yml --
name: CI
on:
  pull_request:
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci --ignore-scripts
      - run: npm run lint
