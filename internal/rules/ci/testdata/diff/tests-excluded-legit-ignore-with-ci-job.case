# pytest addopts ignores tests/e2e and a new CI job runs them explicitly.
expect: clean
-- old/pytest.ini --
[pytest]
addopts = -ra
-- new/pytest.ini --
[pytest]
addopts = -ra --ignore=tests/e2e
-- new/.github/workflows/e2e.yml --
name: E2E
on: [pull_request]
jobs:
  e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: docker compose up -d
      - run: pytest tests/e2e -p no:cacheprovider
