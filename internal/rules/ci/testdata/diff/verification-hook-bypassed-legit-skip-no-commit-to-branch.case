# CI skips no-commit-to-branch, which always fails on main.
expect: clean
-- old/.github/workflows/lint.yml --
name: Lint
on: [push]
jobs:
  pre-commit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: pre-commit run --all-files
-- new/.github/workflows/lint.yml --
name: Lint
on: [push]
jobs:
  pre-commit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: SKIP=no-commit-to-branch pre-commit run --all-files
