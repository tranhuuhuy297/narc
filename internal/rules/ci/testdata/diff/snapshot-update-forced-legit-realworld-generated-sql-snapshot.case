  '''
  SELECT entity_id, variant
  FROM events
  WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), equals(event, '$feature_flag_called'), equals(properties.$feature_flag, 'checkout-redesign'))
  GROUP BY entity_id
  '''
