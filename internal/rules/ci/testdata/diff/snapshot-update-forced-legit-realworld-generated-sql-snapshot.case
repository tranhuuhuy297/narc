# serializer version: 1
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_exposures
  '''
  SELECT entity_id, variant
  FROM events
  WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign'))
  GROUP BY entity_id
  '''
