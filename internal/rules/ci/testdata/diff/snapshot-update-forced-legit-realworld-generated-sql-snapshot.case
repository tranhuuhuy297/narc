# The exposure query now also counts $experiment_exposure events; the generated-SQL snapshot changes exactly there, plus the hash of the query text.
expect: clean
-- old/products/experiments/backend/hogql_queries/exposure_query_logic.py --
from posthog.hogql import ast


def exposure_event_filter() -> ast.Expr:
    return ast.CompareOperation(
        op=ast.CompareOperationOp.Eq,
        left=ast.Field(chain=["event"]),
        right=ast.Constant(value="$feature_flag_called"),
    )
-- new/products/experiments/backend/hogql_queries/exposure_query_logic.py --
from posthog.hogql import ast

EXPOSURE_EVENTS = ["$feature_flag_called", "$experiment_exposure"]


def exposure_event_filter() -> ast.Expr:
    return ast.CompareOperation(
        op=ast.CompareOperationOp.In,
        left=ast.Field(chain=["event"]),
        right=ast.Array(exprs=[ast.Constant(value=e) for e in EXPOSURE_EVENTS]),
    )
-- old/products/experiments/backend/hogql_queries/test/__snapshots__/test_experiment_query_builder.ambr --
# serializer version: 1
