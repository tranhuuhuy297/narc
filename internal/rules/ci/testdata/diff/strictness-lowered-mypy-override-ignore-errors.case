# A pyproject mypy override silences all type errors in the billing package.
expect: strictness-lowered
-- old/pyproject.toml --
[tool.mypy]
strict = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
-- new/pyproject.toml --
[tool.mypy]
strict = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false

[[tool.mypy.overrides]]
module = "billing.*"
ignore_errors = true
