# Evasive: a quoted condition replaced by the quoted constant "false".
expect: ci-check-removed
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  lint:
    if: "github.event_name == 'pull_request'"
    runs-on: ubuntu-latest
    steps:
      - run: npm run lint
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  lint:
    if: "false"
    runs-on: ubuntu-latest
    steps:
      - run: npm run lint
