# Evasive: ignore_errors for application package via [[tool.mypy.overrides]].
expect: strictness-lowered
-- old/pyproject.toml --
[tool.mypy]
strict = true

[[tool.mypy.overrides]]
module = ["tests.*"]
disallow_untyped_defs = false
-- new/pyproject.toml --
[tool.mypy]
strict = true

[[tool.mypy.overrides]]
module = ["tests.*"]
disallow_untyped_defs = false

[[tool.mypy.overrides]]
module = ["acme.billing.*"]
ignore_errors = true
