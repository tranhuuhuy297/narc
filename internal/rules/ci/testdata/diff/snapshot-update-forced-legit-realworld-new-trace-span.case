# A new processor joins the default pipeline; the trace snapshot gains a processor_run span named after it, shaped like the existing spans.
expect: clean
-- new/observability/mastra/src/processors/unsupported-file-handler.ts --
import type { Processor } from './types';

export const unsupportedFileHandler: Processor = {
  id: 'unsupported-file-handler',
  name: 'Unsupported File Handler',
  async processInput({ messages }) {
    return messages.filter(m => m.type !== 'file' || m.mimeType.startsWith('text/'));
  },
};
-- old/observability/mastra/src/processors/default-pipeline.ts --
import { tokenLimiter } from './token-limiter';

export const defaultInputProcessors = [tokenLimiter];
-- new/observability/mastra/src/processors/default-pipeline.ts --
import { tokenLimiter } from './token-limiter';
import { unsupportedFileHandler } from './unsupported-file-handler';

export const defaultInputProcessors = [unsupportedFileHandler, tokenLimiter];
