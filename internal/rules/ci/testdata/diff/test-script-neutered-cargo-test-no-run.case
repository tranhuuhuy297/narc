# cargo test --no-run only compiles the tests.
expect: test-script-neutered
-- old/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: cargo test --locked
-- new/.github/workflows/rust.yml --
name: Rust
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: cargo test --locked --no-run
