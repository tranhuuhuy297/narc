# Bare patch: '|| true' appended to the pytest step.
expect: ci-failure-ignored
patch-only: true
-- old/.github/workflows/ci.yml --
name: CI
on: [push]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: pip install -r requirements.txt
      - run: python -m pytest -x
      - run: echo done
-- new/.github/workflows/ci.yml --
name: CI
on: [push]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: pip install -r requirements.txt
      - run: python -m pytest -x || true
      - run: echo done
