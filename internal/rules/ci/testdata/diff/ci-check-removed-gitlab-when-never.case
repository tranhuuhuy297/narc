# GitLab job that runs rspec set to when: never.
expect: ci-check-removed
-- old/.gitlab-ci.yml --
rspec:
  stage: test
  image: ruby:3.3
  script:
    - bundle install
    - bundle exec rspec
-- new/.gitlab-ci.yml --
rspec:
  stage: test
  image: ruby:3.3
  when: never
  script:
    - bundle install
    - bundle exec rspec
