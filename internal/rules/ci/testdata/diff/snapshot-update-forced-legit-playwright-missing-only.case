# Playwright --update-snapshots=missing only writes snapshots that do not exist yet.
expect: clean
-- old/.github/workflows/e2e.yml --
name: E2E
on: [pull_request]
jobs:
  e2e:
    runs-on: ubuntu-latest
    steps:
      - run: npx playwright test
-- new/.github/workflows/e2e.yml --
name: E2E
on: [pull_request]
jobs:
  e2e:
    runs-on: ubuntu-latest
    steps:
      - run: npx playwright test --update-snapshots=missing
