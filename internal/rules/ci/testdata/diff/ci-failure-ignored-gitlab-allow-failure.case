# GitLab test job switched to allow_failure so a red suite no longer blocks the merge.
expect: ci-failure-ignored
-- old/.gitlab-ci.yml --
stages: [build, test]

build:
  stage: build
  script:
    - npm ci
    - npm run build

unit-tests:
  stage: test
  image: node:20
  script:
    - npm ci
    - npm run test -- --ci
-- new/.gitlab-ci.yml --
stages: [build, test]

build:
  stage: build
  script:
    - npm ci
    - npm run build

unit-tests:
  stage: test
  image: node:20
  allow_failure: true
  script:
    - npm ci
    - npm run test -- --ci
