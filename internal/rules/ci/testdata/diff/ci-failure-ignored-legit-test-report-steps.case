# Posting test results as a PR comment may fail on fork PRs; the test step itself still gates.
expect: clean
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npm test -- --reporter=junit --outputFile=junit.xml
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npm test -- --reporter=junit --outputFile=junit.xml
      - name: Comment test results on PR
        if: always()
        continue-on-error: true
        uses: marocchino/sticky-pull-request-comment@v2
        with:
          path: junit.xml
      - name: Test report
        if: always()
        continue-on-error: true
        uses: dorny/test-reporter@v1
        with:
          name: Vitest
          path: junit.xml
          reporter: jest-junit
