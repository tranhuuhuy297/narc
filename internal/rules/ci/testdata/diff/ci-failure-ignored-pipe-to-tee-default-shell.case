# The test output is piped into tee for a log; GitHub's default shell has no pipefail, so failures are hidden.
expect: ci-failure-ignored@warning
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
      - run: go test ./...
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
      - run: go test -v ./... 2>&1 | tee go-test.log
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: go-test-log
          path: go-test.log
