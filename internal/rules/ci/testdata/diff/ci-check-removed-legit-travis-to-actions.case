# Travis CI replaced by an equivalent GitHub Actions workflow.
expect: clean
-- old/.travis.yml --
language: node_js
node_js:
  - "20"
script:
  - npm run lint
  - npm test
-- new/.github/workflows/ci.yml --
name: CI
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm ci
      - run: npm run lint
      - run: npm test
