# Evasive: a flow-mapping step hides `|| true` on the test command.
expect: ci-failure-ignored
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - { name: Test, run: npm test }
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - { name: Test, run: "npm test || true" }
