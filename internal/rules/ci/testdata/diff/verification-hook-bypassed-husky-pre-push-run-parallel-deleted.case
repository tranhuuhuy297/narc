# Evasive: the pre-push hook that ran fmt-check, clippy and the test suite through a run_parallel helper is deleted, so pushes no longer run any of them.
expect: verification-hook-bypassed
-- old/.husky/pre-push --
#!/usr/bin/env bash
# Run commands in parallel, exit 1 if any fail.
# Usage: run_parallel "label1" "cmd1" "label2" "cmd2" ...
run_parallel() {
  local -a labels=() pids=()
  while [[ $# -ge 2 ]]; do
    labels+=("$1"); shift
    ( eval "$1" ) & pids+=($!); shift
  done
  local -a failed=()
  for i in "${!pids[@]}"; do
    wait "${pids[$i]}" || failed+=("${labels[$i]}")
  done
  [[ ${#failed[@]} -eq 0 ]] || { echo "Failed: ${failed[*]}"; return 1; }
}

run_parallel \
  "fmt-check"  "cargo fmt --all -- --check" \
  "clippy"     "cargo clippy --all-targets -- -D warnings" \
  "test"       "cargo test --workspace"
