# enabled = false inside tasks.named('test') (Groovy DSL, task named in quotes).
expect: test-script-neutered
-- old/build.gradle --
plugins {
    id 'java'
}

tasks.named('test') {
    useJUnitPlatform()
}
-- new/build.gradle --
plugins {
    id 'java'
}

tasks.named('test') {
    useJUnitPlatform()
    enabled = false
}
