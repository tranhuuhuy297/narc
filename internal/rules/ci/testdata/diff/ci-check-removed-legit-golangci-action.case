# golangci-lint invocation replaced by the official action.
expect: clean
-- old/.github/workflows/lint.yml --
name: Lint
on: [pull_request]
jobs:
  golangci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s v1.59.1
      - run: ./bin/golangci-lint run ./...
-- new/.github/workflows/lint.yml --
name: Lint
on: [pull_request]
jobs:
  golangci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: golangci/golangci-lint-action@v6
        with:
          version: v1.59.1
