# The job becomes a Node matrix whose only experimental entry (Node 23) may fail via ${{ matrix.experimental }}.
expect: clean
-- old/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm ci
      - run: npm test
-- new/.github/workflows/ci.yml --
name: CI
on: [pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    continue-on-error: ${{ matrix.experimental }}
    strategy:
      fail-fast: false
      matrix:
        node: [18, 20, 22]
        experimental: [false]
        include:
          - node: 23
            experimental: true
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
      - run: npm ci
      - run: npm test
