expect: test-deleted@error
-- old/src/sentry/notifications/notification_action/registry.py --
class BaseIssueAlertHandler:
    @classmethod
    def create_rule_instance_from_action(cls, action: Action, workflow_id: int | None = None) -> Rule:
        if workflow_id is None:
            raise ValueError("workflow_id is required")
        return Rule(id=workflow_id, label=action.label, data={"actions": [action.data]})
