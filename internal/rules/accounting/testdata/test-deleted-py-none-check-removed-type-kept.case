-- old/tests/sentry/notifications/notification_action/test_issue_alert_registry_handlers.py --
import pytest

from sentry.notifications.notification_action.registry import BaseIssueAlertHandler


class TestBaseIssueAlertHandler:
    def test_create_rule_instance_from_action(self, action):
        rule = BaseIssueAlertHandler.create_rule_instance_from_action(action, workflow_id=7)
        assert rule.id == 7

    def test_create_rule_instance_missing_workflow_id_raises_value_error(self, action):
        with pytest.raises(ValueError):
            BaseIssueAlertHandler.create_rule_instance_from_action(action, workflow_id=None)
-- new/tests/sentry/notifications/notification_action/test_issue_alert_registry_handlers.py --
import pytest

from sentry.notifications.notification_action.registry import BaseIssueAlertHandler


class TestBaseIssueAlertHandler:
    def test_create_rule_instance_from_action(self, action):
        rule = BaseIssueAlertHandler.create_rule_instance_from_action(action, workflow_id=7)
        assert rule.id == 7
