from warehouse_sources.amazon_ads.amazon_ads import validate_credentials


@mock.patch("warehouse_sources.amazon_ads.amazon_ads.requests")
def test_validate_credentials_accepts_200(mock_requests):
    mock_requests.post.return_value.status_code = 200
    assert validate_credentials("na", "cid", "sec", "rt") is True
-- new/warehouse_sources/amazon_ads/tests/test_amazon_ads.py --
from unittest import mock

import pytest

from warehouse_sources.amazon_ads.amazon_ads import validate_credentials


@pytest.mark.parametrize(
    "status_code, expected_valid, expected_message",
    [
        (200, True, None),
        (401, False, "Amazon Ads rejected the client ID or secret"),
        (400, False, "Amazon Ads rejected the refresh token"),
    ],
)
@mock.patch("warehouse_sources.amazon_ads.amazon_ads.requests")
def test_validate_credentials_reports_each_outcome(mock_requests, status_code, expected_valid, expected_message):
    mock_requests.post.return_value.status_code = status_code
    assert validate_credentials("na", "cid", "sec", "rt") == (expected_valid, expected_message)
-- old/warehouse_sources/amazon_ads/tests/test_amazon_ads_source.py --
from unittest import mock

import pytest

from warehouse_sources.amazon_ads.source import AmazonAdsSource


class TestAmazonAdsSource:
    def setup_method(self):
        self.source = AmazonAdsSource()
        self.config = mock.Mock(region="na", client_id="cid", client_secret="sec", refresh_token="rt")

    @pytest.mark.parametrize(
        "mock_return, expected_valid, expected_message",
        [(True, True, None), (False, False, "Invalid Amazon Ads credentials")],
    )
    @mock.patch("warehouse_sources.amazon_ads.source.validate_amazon_ads_credentials")
    def test_validate_credentials(self, mock_validate, mock_return, expected_valid, expected_message):
        mock_validate.return_value = mock_return

        is_valid, error_message = self.source.validate_credentials(self.config, 123)

        assert is_valid is expected_valid
        assert error_message == expected_message
        mock_validate.assert_called_once_with("na", "cid", "sec", "rt")
