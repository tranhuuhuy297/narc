# Go: the balance checks moved into a t.Helper() function.
expect: clean
-- old/bank/deposit_test.go --
package bank

import "testing"

func TestDeposit(t *testing.T) {
	a := &Account{Balance: 100}
	a.Deposit(50)
	if a.Balance != 150 {
		t.Errorf("Balance = %d, want 150", a.Balance)
	}
}
-- new/bank/deposit_test.go --
package bank

import "testing"

func balanceIs(t *testing.T, a *Account, want int64) {
	t.Helper()
	if a.Balance != want {
		t.Errorf("Balance = %d, want %d", a.Balance, want)
	}
}

func TestDeposit(t *testing.T) {
	a := &Account{Balance: 100}
	a.Deposit(50)
	balanceIs(t, a, 150)
}
