# RSpec: the expectation on the error message was dropped.
expect: assertions-removed
-- old/spec/models/order_spec.rb --
require "rails_helper"

RSpec.describe Order do
  it "is invalid without line items" do
    order = build(:order, line_items: [])
    expect(order).not_to be_valid
    expect(order.errors[:line_items]).to include("can't be blank")
  end
end
-- new/spec/models/order_spec.rb --
require "rails_helper"

RSpec.describe Order do
  it "is invalid without line items" do
    order = build(:order, line_items: [])
    expect(order).not_to be_valid
  end
end
