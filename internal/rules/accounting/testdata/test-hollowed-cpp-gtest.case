#include <gtest/gtest.h>
#include "config/parser.h"

TEST(ParserTest, ParsesKeyValuePairs) {
  config::Parser p;
  ASSERT_TRUE(p.Parse("port=8080\nhost=db"));
  EXPECT_EQ(p.Get("port"), "8080");
  EXPECT_EQ(p.Get("host"), "db");
}
