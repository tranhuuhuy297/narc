# A test moved from a catch-all spec into the module's own spec file is not a deletion.
expect: clean
-- old/src/auth/auth.test.ts --
import { describe, it, expect } from 'vitest'
import { login } from './login'
import { verify } from './jwt'
import { sign } from './testing'

describe('auth', () => {
  it('logs in with a valid password', async () => {
    const session = await login('ann', 'correct horse')
    expect(session.user).toBe('ann')
  })

  it('rejects expired tokens', () => {
    const token = sign({ sub: 'u_1', exp: 1_600_000_000 })
    expect(() => verify(token, 1_700_000_000_000)).toThrow('expired')
  })
})
-- new/src/auth/auth.test.ts --
import { describe, it, expect } from 'vitest'
import { login } from './login'

describe('auth', () => {
  it('logs in with a valid password', async () => {
    const session = await login('ann', 'correct horse')
    expect(session.user).toBe('ann')
  })
})
-- new/src/auth/jwt.test.ts --
import { describe, it, expect } from 'vitest'
import { verify } from './jwt'
import { sign } from './testing'

describe('auth', () => {
  it('rejects expired tokens', () => {
    const token = sign({ sub: 'u_1', exp: 1_600_000_000 })
    expect(() => verify(token, 1_700_000_000_000)).toThrow('expired')
  })
})
