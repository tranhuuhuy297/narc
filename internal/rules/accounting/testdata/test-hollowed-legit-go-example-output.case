-- new/money/example_test.go --
package money_test

import (
	"fmt"

	"example.com/shop/money"
)

func ExampleFormat() {
	fmt.Println(money.Format(1999, "EUR"))
	fmt.Println(money.Format(5, "EUR"))
	// Output:
	// €19.99
	// €0.05
}
