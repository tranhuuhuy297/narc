import XCTest
@testable import Keychain

final class TokenStoreTests: XCTestCase {
    var store: TokenStore!

    override func setUp() {
        store = TokenStore(backend: InMemoryBackend())
    }

    func testSavesAndLoadsToken() throws {
        try store.save("abc", for: "api")
        XCTAssertEqual(try store.load(for: "api"), "abc")
