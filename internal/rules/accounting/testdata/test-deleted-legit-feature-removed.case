# Java: the deprecated CSV export was removed together with its test.
expect: clean
-- old/src/main/java/com/acme/reports/ReportExporter.java --
package com.acme.reports;

public class ReportExporter {
    public String toJson(Report report) {
        return Json.write(report);
    }

    @Deprecated
    public String toCsv(Report report) {
        return Csv.write(report.rows());
    }
}
