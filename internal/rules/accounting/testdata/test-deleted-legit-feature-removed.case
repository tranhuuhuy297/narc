-- old/src/test/java/com/acme/reports/ReportExporterTest.java --
package com.acme.reports;

import static org.junit.jupiter.api.Assertions.assertEquals;

import org.junit.jupiter.api.Test;

class ReportExporterTest {
    private final ReportExporter exporter = new ReportExporter();

    @Test
    void exportsJson() {
        assertEquals("{\"rows\":[]}", exporter.toJson(Report.empty()));
    }

    @Test
    void exportsCsv() {
        assertEquals("", exporter.toCsv(Report.empty()));
    }
}
-- new/src/test/java/com/acme/reports/ReportExporterTest.java --
package com.acme.reports;

