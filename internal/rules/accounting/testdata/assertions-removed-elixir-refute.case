# ExUnit: the refute on the admin flag was deleted.
expect: assertions-removed
-- old/test/my_app/accounts_test.exs --
defmodule MyApp.AccountsTest do
  use MyApp.DataCase, async: true

  test "register/1 creates a regular member" do
    assert {:ok, user} = MyApp.Accounts.register(%{email: "ann@example.com"})
    assert user.role == :member
    refute user.admin
  end
end
-- new/test/my_app/accounts_test.exs --
defmodule MyApp.AccountsTest do
  use MyApp.DataCase, async: true

  test "register/1 creates a regular member" do
    assert {:ok, user} = MyApp.Accounts.register(%{email: "ann@example.com"})
    assert user.role == :member
  end
end
