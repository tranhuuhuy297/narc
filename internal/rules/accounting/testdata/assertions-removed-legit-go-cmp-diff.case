# Go: per-field t.Errorf checks replaced by one cmp.Diff against a want struct.
expect: clean
-- old/config/load_test.go --
package config

import "testing"

func TestLoad(t *testing.T) {
	cfg, err := Load("testdata/app.toml")
	if err != nil {
		t.Fatal(err)
	}
	if cfg.Port != 8080 {
		t.Errorf("Port = %d, want 8080", cfg.Port)
	}
	if cfg.Host != "localhost" {
		t.Errorf("Host = %q, want localhost", cfg.Host)
	}
	if !cfg.Debug {
		t.Error("Debug = false, want true")
	}
}
-- new/config/load_test.go --
package config

import (
	"testing"

	"github.com/google/go-cmp/cmp"
)

func TestLoad(t *testing.T) {
	cfg, err := Load("testdata/app.toml")
	if err != nil {
		t.Fatal(err)
	}
	want := Config{Port: 8080, Host: "localhost", Debug: true}
	if diff := cmp.Diff(want, cfg); diff != "" {
		t.Errorf("Load mismatch (-want +got):\n%s", diff)
	}
}
