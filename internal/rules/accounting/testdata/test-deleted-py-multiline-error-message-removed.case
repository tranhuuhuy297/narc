# The agent removed the preview gate (its error is raised across several
# lines) and deleted the CLI test that checked the error text. An error
# path removed with its test stays an error, however the raise is laid out.
expect: test-deleted@error
-- old/src/ruff_cli/add_ignore.py --
import click

from .preview import preview_enabled


def add_ignore(paths, settings):
    if not preview_enabled(settings):
        raise click.UsageError(
            "--add-ignore requires preview mode, but preview is disabled"
        )
    return [suppress(path) for path in paths]
-- new/src/ruff_cli/add_ignore.py --
def add_ignore(paths, settings):
    return [suppress(path) for path in paths]
-- old/tests/cli/test_add_ignore.py --
from click.testing import CliRunner

from ruff_cli.main import cli


def test_add_ignore_adds_comments(tmp_path):
    result = CliRunner().invoke(cli, ["check", "--preview", "--add-ignore", str(tmp_path)])
    assert result.exit_code == 0


def test_add_ignore_requires_preview(tmp_path):
    result = CliRunner().invoke(cli, ["check", "--add-ignore", str(tmp_path)])
    assert result.exit_code == 2
    assert "--add-ignore requires preview mode, but preview is disabled" in result.output
-- new/tests/cli/test_add_ignore.py --
from click.testing import CliRunner

from ruff_cli.main import cli


def test_add_ignore_adds_comments(tmp_path):
    result = CliRunner().invoke(cli, ["check", "--preview", "--add-ignore", str(tmp_path)])
    assert result.exit_code == 0
