# A test-only change pruned tests from three files ("prune redundant
# cases"). Existing checks went away, so it is reported, but once for the
# whole change rather than once per test, as a warning: no source code
# changed, so this is not the edit-and-delete move.
expect: test-deleted@warning
-- old/packages/calculator/src/calculate.test.ts --
import { describe, expect, it } from 'vitest';
import { calculate } from './calculate';

describe('calculate', () => {
  it('adds two numbers', () => {
    expect(calculate('1 + 2')).toBe(3);
  });

  it('adds three numbers', () => {
    expect(calculate('1 + 2 + 3')).toBe(6);
  });

  it('respects operator precedence', () => {
    expect(calculate('1 + 2 * 3')).toBe(7);
  });
});
-- new/packages/calculator/src/calculate.test.ts --
import { describe, expect, it } from 'vitest';
import { calculate } from './calculate';

describe('calculate', () => {
  it('adds two numbers', () => {
    expect(calculate('1 + 2')).toBe(3);
  });

  it('respects operator precedence', () => {
    expect(calculate('1 + 2 * 3')).toBe(7);
  });
});
-- old/packages/calculator/src/units.test.ts --
import { describe, expect, it } from 'vitest';
import { convert } from './units';

describe('convert', () => {
  it('converts meters to feet', () => {
    expect(convert(1, 'm', 'ft')).toBeCloseTo(3.2808);
  });

  it('converts feet to meters', () => {
    expect(convert(1, 'ft', 'm')).toBeCloseTo(0.3048);
  });

  it('converts celsius to fahrenheit', () => {
    expect(convert(100, 'C', 'F')).toBe(212);
  });
});
-- new/packages/calculator/src/units.test.ts --
import { describe, expect, it } from 'vitest';
import { convert } from './units';

describe('convert', () => {
  it('converts meters to feet', () => {
    expect(convert(1, 'm', 'ft')).toBeCloseTo(3.2808);
  });

  it('converts celsius to fahrenheit', () => {
    expect(convert(100, 'C', 'F')).toBe(212);
  });
});
-- old/packages/calculator/src/format.test.ts --
import { describe, expect, it } from 'vitest';
import { formatResult } from './format';

describe('formatResult', () => {
  it('keeps integers as is', () => {
    expect(formatResult(42)).toBe('42');
  });

  it('rounds long decimals', () => {
    expect(formatResult(1 / 3)).toBe('0.3333');
  });
});
-- new/packages/calculator/src/format.test.ts --
import { describe, expect, it } from 'vitest';
import { formatResult } from './format';

describe('formatResult', () => {
  it('rounds long decimals', () => {
    expect(formatResult(1 / 3)).toBe('0.3333');
  });
});
