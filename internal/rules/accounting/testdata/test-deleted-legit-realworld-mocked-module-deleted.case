-- old/src/features/Portal/Document/Body.test.tsx --
import { render, screen } from '@testing-library/react';
import { describe, expect, it, vi } from 'vitest';

import DocumentBody from './Body';

const meta = vi.hoisted(() => ({ current: { id: 'doc-1', fileId: undefined as string | undefined } }));

vi.mock('./useDocumentMeta', () => ({ useDocumentMeta: () => meta.current }));
vi.mock('./Editor', () => ({ default: () => <div data-testid="editor-canvas" /> }));
vi.mock('./FooterActions', () => ({
  default: ({ fileBacked }: { fileBacked?: boolean }) => (
    <div data-testid="footer-actions">{!fileBacked && <button data-testid="footer-export" type="button" />}</div>
  ),
}));

describe('DocumentBody', () => {
  it('mounts the editor', () => {
    render(<DocumentBody />);
    expect(screen.getByTestId('editor-canvas')).toBeTruthy();
  });

  it('hides the markdown export for a file-backed preview', () => {
    meta.current = { id: 'doc-1', fileId: 'file-1' };
    render(<DocumentBody />);
    expect(screen.getByTestId('footer-actions')).toBeTruthy();
    expect(screen.queryByTestId('footer-export')).toBeNull();
  });

  it('renders the footer actions for an agent document', () => {
    meta.current = { id: 'doc-1', fileId: undefined };
    render(<DocumentBody />);
    expect(screen.getByTestId('footer-export')).toBeTruthy();
  });
});
-- new/src/features/Portal/Document/Body.test.tsx --
import { render, screen } from '@testing-library/react';
import { describe, expect, it, vi } from 'vitest';

import DocumentBody from './Body';

const meta = vi.hoisted(() => ({ current: { id: 'doc-1', fileId: undefined as string | undefined } }));

vi.mock('./useDocumentMeta', () => ({ useDocumentMeta: () => meta.current }));
vi.mock('./Editor', () => ({ default: () => <div data-testid="editor-canvas" /> }));

describe('DocumentBody', () => {
  it('mounts the editor', () => {
    render(<DocumentBody />);
    expect(screen.getByTestId('editor-canvas')).toBeTruthy();
  });
});
