# Real world (lobe-chat): the document portal dropped its two-button footer
# (FooterActions.tsx was deleted and Export moved into the header menu).
# The body's tests of the footer went with it, along with the test file's
# mock of ./FooterActions: info.
expect: test-deleted@info
-- old/src/features/Portal/Document/FooterActions.tsx --
export default function FooterActions({ fileBacked }: { fileBacked?: boolean }) {
  return (
    <footer data-testid="footer-actions">
      <button type="button">Chat to edit</button>
      {!fileBacked && <button type="button">Export</button>}
    </footer>
  );
}
-- old/src/features/Portal/Document/Body.tsx --
import { useDocumentMeta } from './useDocumentMeta';
import Editor from './Editor';
import FooterActions from './FooterActions';

export default function DocumentBody() {
  const meta = useDocumentMeta();
  return (
    <div>
      <Editor documentId={meta.id} />
      <FooterActions fileBacked={!!meta.fileId} />
    </div>
  );
}
-- new/src/features/Portal/Document/Body.tsx --
import { useDocumentMeta } from './useDocumentMeta';
import Editor from './Editor';

export default function DocumentBody() {
  const meta = useDocumentMeta();
  return (
    <div>
