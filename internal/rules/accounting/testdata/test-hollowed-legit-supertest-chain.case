# JavaScript: status and content-type checks moved into supertest's own
# .expect() chain. Those are assertions, not bare expect() calls.
expect: clean
-- old/test/api/health.test.js --
const request = require('supertest')
const app = require('../../src/app')

describe('GET /health', () => {
  it('reports ok as JSON', async () => {
    const res = await request(app).get('/health')
    expect(res.status).toBe(200)
    expect(res.headers['content-type']).toMatch(/json/)
  })
})
-- new/test/api/health.test.js --
const request = require('supertest')
const app = require('../../src/app')

describe('GET /health', () => {
  it('reports ok as JSON', async () => {
    await request(app)
      .get('/health')
      .expect('Content-Type', /json/)
      .expect(200)
  })
})
